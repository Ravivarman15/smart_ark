# ─────────────────────────────────────────────────────────────
# Smart Ark — environment variables
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# Supabase — safe to expose (publishable key has RLS enforced server-side)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Public app URL — used for login + password-reset links in onboarding emails.
# Set this to the DEPLOYED site so email links work on the recipient's device,
# not the localhost of whoever created the staff member. Leave blank in local
# dev to fall back to the current browser origin.
#   e.g. VITE_PUBLIC_APP_URL="https://your-app.vercel.app"
VITE_PUBLIC_APP_URL=""

# Public MARKETING origin — the canonical host for SEO.
#
# Drives every <link rel="canonical">, og:url and sitemap.xml entry, in both the
# runtime SEO hook and scripts/prerender-marketing.mjs. Leave BLANK to use the
# current deployment (https://smart-ark-main.vercel.app).
#
# When a real domain is purchased, set it here and redeploy — that is the only
# change required. Do NOT point this at a domain that does not resolve yet:
# canonical tags naming a dead host tell Google the real pages are duplicates
# of nothing, and every shared link previews as broken.
#   e.g. VITE_PUBLIC_SITE_URL="https://smartark.ai"
VITE_PUBLIC_SITE_URL=""

# ─────────────────────────────────────────────────────────────
# Secrets below live in Supabase Edge Function secrets ONLY.
# Do NOT put them in this file or in `.env`.
#   npx supabase secrets set AISENSY_API_KEY=<value>
#   npx supabase secrets set BREVO_API_KEY=<value>
#   npx supabase secrets set SENDER_EMAIL=<verified-brevo-sender>
#   npx supabase secrets set SENDER_NAME="The Ark Tuition"   # optional
# ─────────────────────────────────────────────────────────────
# AISENSY_API_KEY    — WhatsApp notifications (edge function only)
# BREVO_API_KEY      — Brevo transactional email API key (invite-staff,
#                      send-email edge functions). Until set, staff accounts
#                      are still created and the temporary password is shown
#                      to the admin in-app instead of emailed.
# SENDER_EMAIL       — verified Brevo sender address used as the "From".
# SENDER_NAME        — optional display name for the "From" (default: org name).
