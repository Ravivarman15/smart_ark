<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config — force HTTPS everywhere.
  The app talks to Supabase (https://*.supabase.co) only. No cleartext
  HTTP is permitted, not even on debug builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
