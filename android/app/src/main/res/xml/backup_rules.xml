<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below auto-backup rules.
  We disable auto-backup entirely for this app because localStorage
  contains Supabase session tokens and user role data.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
